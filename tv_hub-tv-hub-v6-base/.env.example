# This file is used automatically only for local development when .env is absent.
# Copy it to .env to customize your local configuration.
# Never use these example JWT secrets in production.
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/tvhub
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Report operations (V5.1). Without SMTP_HOST, development uses a temporary
# Ethereal account and logs a preview URL after each notification.
REPORT_NOTIFICATION_EMAIL=reports@tvhub.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TV Hub <no-reply@tvhub.local>

# Classroom defaults: scan every minute and escalate OPEN reports after 2 minutes.
# Production can use a much larger threshold, for example 240 minutes.
REPORT_ESCALATION_MINUTES=2
REPORT_ESCALATION_CRON=*/1 * * * *
